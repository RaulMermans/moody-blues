# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# --- Backend --------------------------------------------------------------------------
MOODY_ENVIRONMENT=development
MOODY_LOG_LEVEL=INFO
# json (default) or console
MOODY_LOG_FORMAT=console
# JSON list of allowed browser origins
MOODY_CORS_ORIGINS=["http://localhost:3000"]

# --- Vultr Serverless Inference (server-side only; never exposed to the browser) ------
# Create a key in the Vultr console (Serverless > Inference). Leave empty to work offline.
MOODY_VULTR_API_KEY=
MOODY_VULTR_BASE_URL=https://api.vultrinference.com/v1
# Verified live with tool calling (Sprint 3/4). Confirm with `make vultr-models`.
MOODY_VULTR_MODEL=glm-5.3
MOODY_VULTR_TIMEOUT_SECONDS=30
MOODY_VULTR_MAX_RETRIES=2
# Optional, for cost estimates in agent run reports only. Leave unset if unknown.
# MOODY_VULTR_PRICE_PER_MILLION_TOKENS_USD=

# Application-side spending guard: an ESTIMATE, not a provider billing limit.
# See docs/deployment/live-budget.md.
# MOODY_LIVE_SPEND_LIMIT_USD=5
# MOODY_LIVE_PRICE_CEILING_INPUT_PER_MILLION_USD=1.40
# MOODY_LIVE_PRICE_CEILING_OUTPUT_PER_MILLION_USD=4.40

# --- Investigator (live commands need CONFIRM=1) --------------------------------------
# MOODY_INVESTIGATOR_MODEL=glm-5.3
# MOODY_INVESTIGATOR_TARGET_MODEL=glm-5.3
# MOODY_INVESTIGATOR_TIMEOUT_SECONDS=120
# MOODY_INVESTIGATOR_MAX_RETRIES=1
# MOODY_INVESTIGATOR_MAX_SPEND_USD=0.75
# Digest-pinned image for model-generated code. Never pulled implicitly.
# MOODY_GENERATED_CODE_IMAGE=python:3.12-slim@sha256:...

# --- Investigation Explorer ------------------------------------------------------------
# Unset means every /operator route answers 403. At least 32 characters when set. Create one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(36))"
# MOODY_OPERATOR_TOKEN=
# Chargeable missions stay refused unless this is true AND the ledger covers one investigation.
# MOODY_LIVE_RUNS_ENABLED=false
# Defaults: evidence/recorded and .artifacts in this repository.
# MOODY_RECORDED_EVIDENCE_DIR=
# MOODY_ARTIFACTS_DIR=
# MOODY_CONTAINMENT_REPORT=
# Hosted only: settled spend below this means the ledger was lost, and spending is refused.
# MOODY_LIVE_LEDGER_FLOOR_USD=0

# --- Sandbox ---------------------------------------------------------------------------
# Leave unset to auto-detect (DOCKER_HOST, then the active `docker context`).
# MOODY_DOCKER_HOST=unix:///Users/you/.colima/default/docker.sock
MOODY_SANDBOX_IMAGE=python:3.12-slim
MOODY_SANDBOX_WALL_TIMEOUT_SECONDS=10
MOODY_SANDBOX_MEMORY_MB=128
MOODY_SANDBOX_CPUS=0.5
MOODY_SANDBOX_PIDS_LIMIT=64

# --- Frontend (server-side; read by the Next.js /api/status route at request time) -----
MOODY_BACKEND_URL=http://127.0.0.1:8000
# Hosted only: the exact https origin. It sets the Secure cookie flag and the origin check.
# MOODY_PUBLIC_ORIGIN=https://example.com
