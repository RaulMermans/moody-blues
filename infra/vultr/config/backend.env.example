# /etc/moody-blues/backend.env, root:moody 0640. deploy.sh never overwrites it. No real values here.
MOODY_ENVIRONMENT=production
MOODY_LOG_LEVEL=INFO
MOODY_LOG_FORMAT=json
MOODY_ARTIFACTS_DIR=/var/lib/moody-blues/artifacts
MOODY_RECORDED_EVIDENCE_DIR=/opt/moody-blues/current/evidence/recorded
MOODY_CONTAINMENT_REPORT=/var/lib/moody-blues/artifacts/containment/report.json
# Same digest as generated code, so nothing on this host ever pulls an unpinned image.
MOODY_SANDBOX_IMAGE=python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30

# At least 32 characters, created for this host. Do not reuse a local value.
MOODY_OPERATOR_TOKEN=

# Spending stays refused until the owner deliberately changes these two lines.
MOODY_LIVE_RUNS_ENABLED=false
MOODY_LIVE_SPEND_LIMIT_USD=5

# A ledger showing less than this is treated as lost, and all spending is refused. Set from
# the settled figure migrate-ledger.sh prints, so a fresh VM cannot restart from zero.
MOODY_LIVE_LEDGER_FLOOR_USD=6.50

# Provider key. Leave empty until a live run is authorized.
MOODY_VULTR_API_KEY=
MOODY_VULTR_MODEL=glm-5.3
