[Unit]
Description=MOODY BLUES web (Next.js; holds no secret and has no Docker access)
After=network-online.target moody-backend.service
Wants=network-online.target moody-backend.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=moody-web
Group=moody-web
WorkingDirectory=/opt/moody-blues/current/frontend
EnvironmentFile=/etc/moody-blues/web.env
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=4096
MemoryMax=1G
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
