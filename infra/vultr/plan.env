# The reviewed infrastructure plan. No secrets. `provision.sh plan` reads this and prints live prices.
# vc2-4c-8gb: 4 vCPU, 8 GB, 160 GB included. Cheapest 8 GB plan once storage is counted.
# Do not use vx1-g-2c-8g: its $0.06/h buys a 1 GB disk, so it needs block storage on top.
MB_PLAN=vc2-4c-8gb
MB_REGION=fra
MB_OS_ID=2284            # Ubuntu 24.04 LTS x64
MB_LABEL=moody-blues
MB_TAG=moody-blues
MB_HOURLY_CEILING_USD=0.06
